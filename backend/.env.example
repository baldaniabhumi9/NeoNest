# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/neovitals

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Device auth (ESP32 devices authenticate with a per-device key, not a user JWT)
DEVICE_KEY_SALT=change_this_too

# CORS
CLIENT_ORIGIN=http://localhost:5173
